# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me

# Local dev uses SQLite. For production set a Postgres URL and swap the
# adapter in src/payload.config.ts (see the comment there).
DATABASE_URI=file:./nici.db

# Public site URL, used for absolute links, sitemap and share images
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required only when running `npm run seed`. Use a unique password of at
# least 12 characters and change it after the first sign-in.
SEED_EMAIL=
SEED_PASSWORD=

# --- Social feeds (see docs/social-feeds.md) ---
YOUTUBE_API_KEY=
FACEBOOK_PAGE_TOKEN=
