# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me

# Local development uses SQLite. Production must use the Supabase Postgres
# Session pooler connection string (including sslmode=require). The Vercel
# Supabase integration can provide POSTGRES_URL instead.
DATABASE_URI=file:./nici.db

# Public site URL, used for absolute links, sitemap and share images
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required only when running `npm run seed`. Use a unique password of at
# least 12 characters and change it after the first sign-in.
SEED_EMAIL=
SEED_PASSWORD=

# --- Social feeds (see docs/social-feeds.md) ---
YOUTUBE_API_KEY=
FACEBOOK_PAGE_TOKEN=
